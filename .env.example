# Configurazione per lo sviluppo locale in modalità "ibrida":
# PHP e Node girano sul tuo PC, Postgres/Redis/Mailpit in Docker (composer services).
# Per questo gli host dei servizi sono 127.0.0.1 e non i nomi dei container.

APP_NAME="Vivere Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
# DB e app lavorano in UTC; le date si mostrano in questo fuso (config/vivere.php)
APP_DISPLAY_TIMEZONE=Europe/Rome

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vivere
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit cattura tutte le mail in uscita: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Utente/gruppo per il container "laravel.test" di Sail (non usato in modalità ibrida)
WWWUSER=1000
WWWGROUP=1000

# ----- Suite Vivere (config/vivere.php) -----
VIVERE_TERMS_VERSION=2026-10
VIVERE_SUGGESTIONS_URL=
# Informativa privacy da accettare in registrazione (TODO: link definitivo)
VIVERE_PRIVACY_POLICY_URL=
VIVERE_AUDIT_RETENTION_DAYS=730

# Super admin creato da SuperAdminSeeder.
# Password vuota = ne viene generata una casuale, stampata una sola volta durante il seed.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=
SUPERADMIN_USERNAME=Super.Admin
SUPERADMIN_NAME=Super
SUPERADMIN_SURNAME=Admin
