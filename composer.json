{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "vivere/suite",
    "type": "project",
    "description": "Suite di applicativi dell'associazione Vivere (UNIPA): monolite modulare Laravel.",
    "keywords": [
        "laravel",
        "filament",
        "vivere",
        "unipa"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.10",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4.7",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-activitylog": "^5.1",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.63",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"exit(preg_match('/^APP_KEY=.+/m', file_get_contents('.env')) ? 1 : 0);\" && php artisan key:generate --ansi || true",
            "@services",
            "@php artisan migrate --seed --force",
            "npm install",
            "npm run build"
        ],
        "services": [
            "docker compose up -d --wait pgsql redis mailpit"
        ],
        "services:stop": [
            "docker compose stop"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@services",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        },
        "platform-check": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "setup": "Prima installazione: dipendenze, .env, servizi Docker, migration+seed, build frontend",
        "services": "Avvia Postgres, Redis e Mailpit in Docker e aspetta che siano pronti",
        "services:stop": "Ferma i container Docker della suite",
        "dev": "Avvia servizi Docker + server, queue, scheduler, log e Vite (Ctrl+C per fermare)",
        "lint": "Sistema lo stile del codice con Pint",
        "test": "Lint, analisi statica e test"
    }
}
